{
  "name": "backend",
  "version": "1.0.0",
  "description": "Swipe backend — auth, merchant, and QR modules in one modular monolith",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "dotenv -e .env -- tsx watch src/server.ts",
    "build": "prisma generate && tsc && node scripts/copy-prisma-client.mjs",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.0",
    "@fastify/jwt": "^8.0.0",
    "@fastify/rate-limit": "^9.0.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^3.1.0",
    "@prisma/client": "^5.22.0",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.0",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^2.1.0",
    "ioredis": "^5.4.0",
    "nodemailer": "^6.9.14",
    "pino": "^10.3.1",
    "pino-pretty": "^11.3.0",
    "qrcode": "^1.5.3",
    "smile-identity-core": "^3.2.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.41",
    "@types/nodemailer": "^6.4.15",
    "@types/pino": "^7.0.5",
    "@types/qrcode": "^1.5.5",
    "dotenv-cli": "^7.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.0"
  }
