generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────────
model User {
  id         String        @id @default(uuid())
  firstName  String
  lastName   String
  email      String        @unique
  mobile     String        @unique
  password   String
  role       Role          @default(MERCHANT)
  kycStatus  UserKycStatus @default(PENDING)
  isVerified Boolean       @default(false)
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  merchant   Merchant?

  @@map("users")
}

// Temporary registration data (before OTP verify)
model PendingRegistration {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String   @unique
  mobile    String   @unique
  password  String   // hashed
  role      Role     @default(USER)
  emailOtp  String
  mobileOtp String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("pending_registrations")
}

// ─────────────────────────────────────────────
// MERCHANT (Main Entity)
// ─────────────────────────────────────────────
model Merchant {
  id             String            @id @default(uuid())
  userId         String            @unique
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 🏛️ Nigeria Strict Regulatory & KYC Fields (CRITICAL)
  bvn            String?           @unique // Bank Verification Number (11 digits - Highly Sensitive)
  nin            String?           @unique // National Identification Number (11 digits)
  cacNumber      String?           @unique // Corporate Affairs Commission Registration Number (For Registered Businesses)
  tin            String?           @unique // Tax Identification Number (Required for Tier 3 higher volumes)
  kycLevel       KycLevel          @default(TIER_1)
  kycStatus      MerchantKycStatus @default(PENDING)
  rejectionReason String?          // Agar KYC fail ho jaye to wajah save karne ke liye

  // 🪪 Gated KYC onboarding pipeline (Smile ID): BVN → Face → NIN
  bvnStatus       CheckStatus     @default(PENDING)
  bvnAttempts     Int             @default(0)
  bvnConsentAt    DateTime?       // NIBSS iGree consent capture timestamp
  bvnConsentIp    String?

  faceMatchStatus     CheckStatus @default(PENDING)
  faceAttempts        Int         @default(0)
  faceMatchConfidence Float?

  ninStatus       CheckStatus     @default(PENDING)
  ninAttempts     Int             @default(0)

  // Canonical name returned by Smile ID's BVN match — source of truth for
  // later steps once BVN is verified, instead of the raw user-typed name.
  verifiedName    String?

  // 🏢 Step 1: Business Info (first step — no numeric MCC code collected,
  // only the human-readable category from a fixed dropdown)
  tradeName              String?
  mccCategory            String?
  expectedMonthlyVolume  Decimal?    @db.Decimal(14, 2)
  socialHandles          Json?

  // 🏠 Step 5: Address — LGA + proof-of-address (Tier 2/3 only), uploaded to
  // Cloudinary rather than stored as a blob in Postgres.
  addressLga             String?
  addressProofSubmittedAt DateTime?
  addressProofUrl        String?

  // 🏛️ Step 6: KYB (skipped entirely for INDIVIDUAL_TRADER)
  cacStatus              CheckStatus @default(PENDING)
  cacVerifiedStatus      String?     // raw "Active"/"Inactive" from the CAC lookup
  sectorLicenseNumber    String?     // manual/unverified (e.g. PCN, NAFDAC) — admin-reviewed
  scumlNumber            String?     // required if mccCategory falls under DNFBP categories

  // 🏦 Step 7: Settlement bank re-verification (Monnify BVN-Account Match)
  nubanStatus            CheckStatus @default(PENDING)

  // ✅ Step 9: Final decision consent
  termsAcceptedAt         DateTime?
  privacyConsentAcceptedAt DateTime?

  // 👥 Admin maker-checker review (Step 9 admin queue) — the reviewer and
  // final decider must be two different ADMIN users.
  reviewedByAdminId    String?
  reviewedAt           DateTime?
  reviewRecommendation String?   // 'APPROVE' | 'REJECT'
  reviewNotes          String?
  decidedByAdminId     String?
  decidedAt            DateTime?

  // 📡 Integrations Metadata
  nibssId        String?           @unique
  monnifyReference String?         @unique
  paystackSubaccountCode String?   @unique // Agar Paystack split payments use kar rahe ho code mein

  // 🏢 Business Info
  businessName   String
  businessType   BusinessType      @default(SOLE_PROPRIETORSHIP)
  description    String?

  // 👤 Owner Info
  ownerName      String
  ownerDob       DateTime?         // Strictly mandatory by CBN to match with BVN Data

  // 📧 Contact
  email          String            @unique
  mobile         String            @unique // Nigeria Format (+234...)

  // 🏠 Address (Strictly required for KYC verification alignment)
  addressLine1   String            @default("Not Provided")
  addressLine2   String?
  addressCity    String            @default("Lagos")
  addressState   String            @default("Lagos") // E.g., Lagos, Abuja, Kano
  addressZip     String?
  addressCountry String            @default("Nigeria")

  // 🏦 Bank Details (Settlement Account - NUBAN Specification)
  bankCode       String            // 3-digit Central Bank code (e.g., 011 for First Bank, 058 for GTBank)
  accountNumber  String            // 10-digit NUBAN standard account number
  accountName    String            // System will verify this against BVN

  // 📊 Status & Control Flags
  status         MerchantStatus    @default(PENDING)
  isActive       Boolean           @default(false) // Transaction control flag

  // 📝 Metadata
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  // 🔗 Relations
  qrCodes        QrCode[]
  paymentLinks   PaymentLink[]
  virtualAccounts VirtualAccount[] // Multiple virtual accounts support (for dynamic routes)
  kycAuditLogs   KycAuditLog[]
  persons        MerchantPerson[]

  @@map("merchants")
}

// ─────────────────────────────────────────────
// MERCHANT PERSON (Directors / Shareholders / UBOs — PARTNERSHIP & LIMITED_LIABILITY only)
// ─────────────────────────────────────────────
model MerchantPerson {
  id               String      @id @default(uuid())
  merchantId       String
  personRole       PersonRole
  fullName         String
  bvn              String?
  nin              String?
  ownershipPercent Float?
  bvnStatus        CheckStatus @default(PENDING)
  ninStatus        CheckStatus @default(PENDING)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  merchant         Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("merchant_persons")
}

// ─────────────────────────────────────────────
// KYC AUDIT LOG (compliance: every gate transition + BVN consent capture)
// ─────────────────────────────────────────────
model KycAuditLog {
  id         String   @id @default(uuid())
  merchantId String
  step       String   // 'BVN' | 'FACE' | 'NIN'
  action     String   // 'CONSENT_CAPTURED' | 'ATTEMPT' | 'PASS' | 'FAIL' | 'SOFT_BLOCK'
  result     String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("kyc_audit_logs")
}

// ─────────────────────────────────────────────
// VIRTUAL ACCOUNTS (Nigeria Market Specific)
// ─────────────────────────────────────────────
model VirtualAccount {
  id            String   @id @default(uuid())
  merchantId    String
  bankName      String   // e.g., Wema Bank, Providus Bank (provided via Monnify)
  accountNumber String   @unique // The dedicated 10-digit NUBAN
  accountName   String
  createdAt     DateTime @default(now())

  merchant      Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("merchant_virtual_accounts")
}

// ─────────────────────────────────────────────
// QR CODE (merged: was duplicated separately in merchant-service and qr-service)
// ─────────────────────────────────────────────
model QrCode {
  id          String    @id @default(uuid())
  merchantId  String
  type        QrType
  rawData     String    // NIBSS/NQR standard payload string
  imageUrl    String?   // Generated QR image (data URL / S3 / Cloudinary link)
  amount      Decimal?  @db.Decimal(12, 2) // For dynamic QR
  reference   String    @unique
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime? // For dynamic QR

  merchant    Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("qr_codes")
}

// ─────────────────────────────────────────────
// PAYMENT LINK
// ─────────────────────────────────────────────
model PaymentLink {
  id          String   @id @default(uuid())
  merchantId  String
  url         String   @unique
  amount      Decimal? @db.Decimal(12, 2)
  description String?
  isActive    Boolean  @default(true)
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())

  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("payment_links")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────
enum Role {
  USER
  MERCHANT
  ADMIN
}

// User-level KYC tracking (auth flow: PENDING → INITIATED → APPROVED/REJECTED)
enum UserKycStatus {
  PENDING
  INITIATED
  APPROVED
  REJECTED
}

// Merchant onboarding pipeline KYC tracking (distinct state machine from UserKycStatus)
enum MerchantKycStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum MerchantStatus {
  PENDING
  VERIFIED
  IN_PROGRESS
  PENDING_REVIEW
  ACTIVE
  REJECTED
  SUSPENDED
}

enum PersonRole {
  DIRECTOR
  SHAREHOLDER_UBO
}

enum KycLevel {
  TIER_1 // Basic Info + Phone
  TIER_2 // BVN / NIN Linked
  TIER_3 // CAC Documents + Corporate Verification
}

enum BusinessType {
  INDIVIDUAL_TRADER        // informal, no CAC — Tier 1
  SOLE_PROPRIETORSHIP      // CAC Business Name (BN) — Tier 2
  PARTNERSHIP              // CAC registered partnership — Tier 3
  LIMITED_LIABILITY        // Ltd / LLC (CAC RC number) — Tier 3
  INCORPORATED_TRUSTEES    // NGOs, associations (optional — baad mein add kar sakte ho)
}

enum QrType {
  STATIC
  DYNAMIC
}

// Per-check verification status for the gated KYC pipeline (BVN/Face/NIN)
enum CheckStatus {
  PENDING
  VERIFIED
  FAILED
  MANUAL_REVIEW
}
